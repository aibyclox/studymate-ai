  "questions": [
    {
      "id": "ext_doc_1794662791962_axa8_1",
      "question": "Explain the ISO/OSI Reference Model with a neat diagram. Describe the functions and protocols at each layer.",
      "priority": "MUST_PREPARE",
      "marks": 10,
      "module": 1,
      "vtu_exam_years": [
        "July 2023",
        "Jan 2024",
        "Dec 2022"
      ],
      "repeat_frequency": "Very High (Repeated in almost every session)",
      "key_marking_points": [
        "Neat diagram with all 7 layers in correct sequence (Physical to Application) - 3 Marks",
        "Concise explanation of duties for each layer (Framing, Routing, Flow control, Encryption, Port addressing) - 4 Marks",
        "Protocols associated with each layer (e.g. IP, TCP/UDP, HTTP, Ethernet) - 3 Marks"
      ],
      "sample_answer_hint": "7 Layers: Physical (Bits/Signals) -> Data Link (Frames/MAC) -> Network (Packets/IP) -> Transport (Segments/TCP/UDP) -> Session (Dialog) -> Presentation (Syntax/SSL) -> Application (User/HTTP).",
      "document_id": "doc_1794662791962_axa8",
      "is_saved": true
    },
    {
      "id": "ext_doc_1794662791962_axa8_2",
      "question": "Compare Go-Back-N (GBN) and Selective Repeat (SR) sliding window protocols. Calculate efficiency for a noisy channel.",
      "priority": "MUST_PREPARE",
      "marks": 8,
      "module": 2,
      "vtu_exam_years": [
        "Jan 2024",
        "July 2022"
      ],
      "repeat_frequency": "Very High (Direct comparison or numerical)",
      "key_marking_points": [
        "Window size differences (Sender/Receiver window for GBN vs SR) - 3 Marks",
        "Retransmission policy and cumulative vs individual ACK behavior - 3 Marks",
        "Buffer requirements at the receiver side - 2 Marks"
      ],
      "sample_answer_hint": "GBN sender window = N, receiver window = 1. Retransmits all frames after error. Cumulative ACKs. SR sender window = N, receiver window = N. Buffers out-of-order frames, only retransmits lost frame. Individual ACKs.",
      "document_id": "doc_1794662791962_axa8",
      "is_saved": true
    },
    {
      "id": "ext_doc_1794662791962_axa8_3",
      "question": "Explain the working of Distance Vector Routing algorithm with an example network. Describe the Count-to-Infinity problem and its solution.",
      "priority": "IMPORTANT",
      "marks": 10,
      "module": 3,
      "vtu_exam_years": [
        "July/Aug 2023",
        "Jan 2023"
      ],
      "repeat_frequency": "High (Core Module 3 topic)",
      "key_marking_points": [
        "Bellman-Ford equation and routing table updates - 3 Marks",
        "Walkthrough with small 3-4 node topology - 3 Marks",
        "Count-to-Infinity problem explanation - 2 Marks",
        "Solutions: Split Horizon and Poison Reverse - 2 Marks"
      ],
      "sample_answer_hint": "Each router shares distance vectors with immediate neighbors only. Updates routing table using Bellman-Ford: D_x(y) = min_v { c(x,v) + D_v(y) }. Split Horizon prevents routing loops by not sending routes back across the link they were learned from.",
      "document_id": "doc_1794662791962_axa8",
      "is_saved": true
    },
    {
      "id": "ext_doc_1794662791962_axa8_4",
      "question": "Explain the TCP Three-Way Handshake connection establishment and termination processes with state transition timing diagrams.",
      "priority": "PYQ",
      "marks": 8,
      "module": 4,
      "vtu_exam_years": [
        "Dec 2022",
        "July 2021"
      ],
      "repeat_frequency": "Standard VTU Pattern",
      "key_marking_points": [
        "SYN, SYN-ACK, ACK sequence with sequence number increments - 4 Marks",
        "Connection teardown using FIN and ACK packets - 2 Marks",
        "Explanation of TIME-WAIT state and why 2*MSL delay is required - 2 Marks"
      ],
      "sample_answer_hint": "Client sends SYN (seq=x) -> Server replies SYN-ACK (seq=y, ack=x+1) -> Client sends ACK (seq=x+1, ack=y+1). Termination: Client sends FIN -> Server sends ACK -> Server sends FIN -> Client sends ACK and enters TIME-WAIT.",
      "document_id": "doc_1794662791962_axa8",
      "is_saved": true
    },
